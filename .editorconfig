root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

# Biome formats the web code with 2 spaces. Without this, an editor reformats it to 4 and Biome fails.
[*.{ts,js,css,html,svelte}]
indent_size = 2
