# Excerpt of the Cargo.lock inside the iroh-relay 1.4.0 crate (iroh-relay-1.4.0/Cargo.lock, from
# the crates.io package), which `cargo install iroh-relay --locked` builds the server with. The
# guard parses a config with its own toml, from its own lock, and a test fails if a major or minor
# version here is not the guard's: the two would read the same file by different rules.

[[package]]
name = "toml"
version = "1.1.6+spec-1.1.0"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "920602543f0911ab71da12c50d59701da54c196d1a2bf5cb4b75667f137a406a"
dependencies = [
 "indexmap",
 "serde_core",
 "serde_spanned",
 "toml_datetime",
 "toml_parser",
 "toml_writer",
 "winnow",
]

