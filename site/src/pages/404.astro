---
import { REPO } from "../data/links";
import Base from "../layouts/Base.astro";
---

<Base title="Sluice: page not found" description="No page at this address." noindex>
    <section class="section notfound" aria-labelledby="notfound-title">
        <div class="wrap notfound-inner">
            <p class="notfound-code" aria-hidden="true">404</p>
            <h1 id="notfound-title">Nothing came through.</h1>
            <p class="lede">The link may be old, or the page may have moved.</p>
            <div class="actions">
                <a class="button primary" href="/">The landing page</a>
                <a class="button" href={REPO}>GitHub</a>
            </div>
        </div>
    </section>
</Base>
