---
// Version 1, speed first. The hero is a live stream: blocks cross the screen loose and wavering,
// pass the gate, and come out brass and in line. Below it the numbers, the path a file takes with
// a channel that fills as the page scrolls, a replay of a recorded run, and the rest of what the
// tool does as a grid.
//
// Type: the headline opens from Archivo's narrowest width to its widest once, like a gate. The
// palette is the site's own.
import InstallTabs from "../../components/InstallTabs.astro";
import End from "../../components/preview/End.astro";
import { CLI_README, INSTALL, PERFORMANCE, REPO } from "../../data/links";
import { QUICK_INSTALL, RUN_RECEIVER, RUN_SENDER, feature } from "../../data/preview";
import Preview from "../../layouts/Preview.astro";

// The order the lines appeared in across the two terminals.
const panes = [
    { title: "Sending machine", lines: RUN_SENDER, steps: [0, 1, 4, 5, 11] },
    { title: "Receiving machine", lines: RUN_RECEIVER, steps: [2, 3, 6, 7, 8, 9, 10, 12] },
];

// docs/performance.md, written as met.
const numbers = [
    { value: "8", unit: "Gbit/s", what: "on a 10 GbE LAN, NVMe to NVMe, within 10% of iperf3" },
    { value: "4", unit: "Gbit/s", what: "on a single QUIC connection" },
    { lead: "under", value: "2", unit: "s", what: "to the first new byte after kill -9 at 60% of 100 GB" },
    { lead: "under", value: "30", unit: "ms", what: "from a cold start to a printed ticket" },
    { lead: "under", value: "250", unit: "MB", what: "of memory during any transfer" },
];

const stations = [
    {
        title: "Read in place",
        body: "The sender hashes the file where it is and prints a ticket. Nothing is uploaded anywhere first, and no server holds a copy.",
    },
    {
        title: "One direct connection",
        body: "QUIC with TLS 1.3 between the two machines, hole-punched through NAT. Every connection has to negotiate the post-quantum key exchange X25519MLKEM768, or it is closed.",
    },
    {
        title: "Checked at the gate",
        body: "Each block is verified against its BLAKE3 root before it is written. A block that does not match is discarded, so a damaged transfer fails at the block and not after the file is opened.",
    },
    {
        title: "Written, and resumable",
        body: "Only verified bytes reach the output folder. A receive that was killed keeps the ranges it committed, and the next run fetches the rest.",
    },
];

const cells = [
    { ...feature("resume"), art: "resume", span: 3 },
    { ...feature("delta"), art: "delta", span: 3 },
    { ...feature("live"), art: "live", span: 2 },
    { ...feature("pq"), art: "", span: 2 },
    { ...feature("receipts"), art: "", span: 2 },
    { ...feature("mcp"), art: "", span: 3 },
    { ...feature("ui"), art: "", span: 3 },
];
const relay = feature("relay");
---

<Preview
    title="Sluice: files, straight across"
    description="Preview, version 1: a live stream of blocks crossing a gate, the numbers and the path a file takes."
    version={1}
>
    <section class="hero" aria-labelledby="v1-title">
        <canvas class="stream" data-stream aria-hidden="true"></canvas>
        <p class="gate-label" aria-hidden="true">BLAKE3 gate</p>
        <div class="wrap hero-inner">
            <h1 id="v1-title"><span>Files, straight</span> <span>across.</span></h1>
            <div class="hero-foot">
                <p class="lede">
                    Sluice sends files from one computer directly to another over QUIC, verifies
                    every block with BLAKE3 as it lands, and stores nothing in between.
                </p>
                <div class="hero-install">
                    <InstallTabs name="v1" options={QUICK_INSTALL} />
                    <p class="more">
                        <a href={INSTALL}>Every install channel</a>. Free and open source on
                        <a href={REPO}>GitHub</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="wrap numbers" aria-labelledby="v1-numbers">
        <h2 id="v1-numbers" class="visually-hidden">The numbers</h2>
        <dl>
            {
                numbers.map((n) => (
                    <div class="rise">
                        <dt>{n.what}</dt>
                        <dd>
                            {n.lead && <small>{n.lead}</small>}
                            <b data-count={n.value}>{n.value}</b>
                            <span>{n.unit}</span>
                        </dd>
                    </div>
                ))
            }
        </dl>
        <p class="note">
            Each figure has its scenario, hardware and method in
            <a href={PERFORMANCE}>docs/performance.md</a>, beside the iperf3 and fio ceilings of the
            same path.
        </p>
    </section>

    <section class="wrap route" aria-labelledby="v1-route">
        <h2 id="v1-route">The shortest path a file can take</h2>
        <div class="route-body">
            <div class="channel" aria-hidden="true"><i></i></div>
            <ol>
                {
                    stations.map((station) => (
                        <li>
                            <h3>{station.title}</h3>
                            <p>{station.body}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="wrap run" aria-labelledby="v1-run" data-replay>
        <div class="run-head">
            <h2 id="v1-run">Two commands, one run</h2>
            <button class="again" type="button" data-replay-again hidden>Replay</button>
        </div>
        <div class="panes">
            {
                panes.map((pane) => (
                    <figure class="pane glow">
                        <figcaption>
                            <i aria-hidden="true" />
                            {pane.title}
                        </figcaption>
                        <pre translate="no" tabindex="0"><code>{pane.lines.map((line, at) => (
                            <span class={`t-${line.kind}`} data-step={pane.steps[at]} data-kind={line.kind}>{line.text}</span>
                        ))}</code></pre>
                    </figure>
                ))
            }
        </div>
        <p class="note">
            What the terminal printed for a folder of two videos and a note. The ticket is
            shortened. The <a href={CLI_README}>CLI reference</a> has every flag.
        </p>
    </section>

    <section class="wrap more-section" aria-labelledby="v1-more">
        <h2 id="v1-more">Built for the transfers that go wrong</h2>
        <ul class="bento">
            {
                cells.map((cell) => (
                    <li class="cell glow rise" style={`--span:${cell.span}`}>
                        {cell.art === "resume" && (
                            <div class="art art-resume" aria-hidden="true">
                                <i />
                                <i />
                            </div>
                        )}
                        {cell.art === "delta" && (
                            <div class="art art-delta" aria-hidden="true">
                                {Array.from({ length: 48 }, (_, n) => (
                                    <i class:list={{ hot: n === 13 || n === 31 }} />
                                ))}
                            </div>
                        )}
                        {cell.art === "live" && (
                            <div class="art art-live" aria-hidden="true">
                                {Array.from({ length: 6 }, (_, n) => (
                                    <i style={`--n:${n}`} />
                                ))}
                            </div>
                        )}
                        <h3>{cell.title}</h3>
                        <p>{cell.body}</p>
                        <code translate="no">{cell.code}</code>
                    </li>
                ))
            }
            <li class="cell wide glow rise" style="--span:6">
                <h3>{relay.title}</h3>
                <p>{relay.body}</p>
                <code translate="no">{relay.code}</code>
            </li>
        </ul>
    </section>

    <End
        slot="end"
        title="Open the gate."
        body="One small binary for macOS, Linux and Windows. No account to make and nothing to configure before the first send."
    />
</Preview>

<script>
    import "../../scripts/stream";
    import "../../scripts/replay";
    import "../../scripts/count";
</script>

<style>
    section {
        padding-top: var(--section);
    }

    /* Hero: the stream fills the first screen, the headline sits on it. */
    .hero {
        position: relative;
        display: grid;
        min-height: max(100svh, 44rem);
        padding-top: 6.5rem;
        overflow: clip;
    }

    .stream {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        /* stream.ts reads colours through this element, and a transition would hand it a value in
           flight. */
        transition-property: none;
        mask-image: linear-gradient(180deg, transparent 0, #000 22%, #000 78%, transparent 100%);
    }

    /* The gate itself: a brass line down the hero where the canvas turns its blocks. */
    .hero::before {
        content: "";
        position: absolute;
        top: 16%;
        bottom: 10%;
        left: 72%;
        width: 3px;
        background: linear-gradient(180deg, transparent, var(--brass) 18%, var(--brass) 82%, transparent);
        box-shadow: 0 0 28px 2px color-mix(in srgb, var(--brass) 55%, transparent);
    }

    /* A wash under the text, so the stream never fights the words. */
    .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(75% 60% at 20% 72%, var(--basin) 0%, color-mix(in srgb, var(--basin) 88%, transparent) 50%, transparent 100%);
        pointer-events: none;
    }

    .gate-label {
        position: absolute;
        top: calc(16% - 1.7rem);
        left: 72%;
        z-index: 1;
        translate: -50% 0;
        color: var(--brass);
        font-family: var(--font-code);
        font-size: 0.78rem;
        white-space: nowrap;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: grid;
        align-content: end;
        gap: var(--space-4);
        padding-bottom: var(--space-5);
    }

    h1 {
        font-size: min(8.6vw, 8.6rem);
        font-stretch: 125%;
        font-weight: 800;
        line-height: 0.92;
        letter-spacing: -0.045em;
    }

    h1 span {
        display: block;
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: no-preference) {
        h1 {
            animation: open 1100ms cubic-bezier(0.2, 0.9, 0.2, 1) both;
        }
    }

    @keyframes open {
        from {
            font-stretch: 62%;
            letter-spacing: 0;
            opacity: 0;
        }
    }

    .hero-foot {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: var(--space-4);
        align-items: end;
    }

    .lede {
        max-width: 34ch;
        font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
        line-height: 1.4;
    }

    .hero-install :global(.install) {
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .more {
        margin-top: var(--space-1);
        color: var(--mist);
        font-size: var(--step--1);
    }

    section > h2,
    .run-head h2 {
        max-width: 16ch;
        font-size: clamp(2.2rem, 1.2rem + 4.4vw, 5rem);
        font-stretch: 118%;
        font-weight: 750;
        line-height: 0.98;
        letter-spacing: -0.04em;
    }

    /* Numbers: one row, hairlines between, no boxes. */
    .numbers {
        padding-top: var(--space-5);
    }

    .numbers dl {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border-block: 1px solid var(--line);
    }

    .numbers dl div {
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-end;
        gap: 0.6rem;
        padding: var(--space-3) var(--space-2);
    }

    .numbers dl div + div {
        border-left: 1px solid var(--line);
    }

    .numbers dd {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 0.3rem;
        font-size: clamp(2.6rem, 1.4rem + 3.6vw, 4.6rem);
        font-stretch: 75%;
        font-weight: 800;
        line-height: 0.9;
        font-variant-numeric: tabular-nums;
    }

    .numbers small {
        flex-basis: 100%;
        margin-bottom: 0.4rem;
        color: var(--mist);
        font-size: var(--step--1);
        font-stretch: 100%;
        font-weight: 500;
        line-height: 1;
    }

    .numbers dd span {
        color: var(--water);
        font-size: 0.36em;
        font-stretch: 100%;
        font-weight: 650;
    }

    .numbers dt {
        color: var(--mist);
        font-size: var(--step--1);
        line-height: 1.45;
    }

    /* The path: a channel on the left that fills with water as the section scrolls past. */
    .route-body {
        display: grid;
        grid-template-columns: 4px minmax(0, 1fr);
        gap: clamp(1.25rem, 5vw, 4rem);
        margin-top: var(--space-5);
    }

    .channel {
        border-radius: 4px;
        background: var(--line);
    }

    .channel i {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(180deg, var(--water) 0 62%, var(--brass) 62%);
        transform-origin: top;
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            .channel i {
                animation: fill linear both;
                animation-timeline: view();
                animation-range: entry 40% exit 60%;
            }
        }
    }

    @keyframes fill {
        from {
            transform: scaleY(0);
        }
    }

    .route ol {
        display: grid;
        gap: clamp(2.5rem, 7vw, 5.5rem);
        counter-reset: station;
    }

    .route li {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: var(--space-2) var(--space-4);
        align-items: start;
        counter-increment: station;
    }

    .route h3 {
        font-size: clamp(1.7rem, 1.1rem + 2.4vw, 3.2rem);
        font-stretch: 100%;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
    }

    .route h3::before {
        content: "0" counter(station);
        display: block;
        margin-bottom: 0.7rem;
        color: var(--water);
        font-family: var(--font-code);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0;
    }

    .route li:nth-child(n + 3) h3::before {
        color: var(--brass);
    }

    .route li p {
        color: var(--mist);
        font-size: var(--step-1);
        line-height: 1.5;
    }

    /* The recorded run. */
    .run-head {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .again {
        padding: 0.5rem 1.2rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }

    .again:hover {
        border-color: var(--water);
    }

    .again[hidden] {
        display: none;
    }

    .pane {
        border-radius: var(--radius-l);
        overflow: visible;
    }

    .pane figcaption {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .pane figcaption i {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--water);
    }

    .pane:last-child figcaption i {
        background: var(--brass);
    }

    .run pre span {
        display: block;
        min-height: 1.75em;
        white-space: pre;
    }

    .run :global(.is-waiting) {
        opacity: 0;
    }

    /* The grid of everything else. */
    .bento {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: var(--space-2);
        margin-top: var(--space-4);
    }

    .cell {
        grid-column: span var(--span);
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-height: 15rem;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        background: linear-gradient(160deg, var(--stone), color-mix(in srgb, var(--stone) 55%, transparent));
    }

    .cell h3 {
        margin-top: auto;
        font-size: var(--step-2);
        font-stretch: 100%;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .cell p {
        max-width: 52ch;
        color: var(--mist);
        line-height: 1.5;
    }

    .cell code {
        align-self: start;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .cell.wide {
        min-height: 0;
    }

    .art {
        margin-bottom: var(--space-3);
    }

    /* Resume: the brass part is kept, the water part is what the next run still fetches. */
    .art-resume {
        display: flex;
        gap: 3px;
        height: 1.4rem;
    }

    .art-resume i {
        border-radius: 4px;
    }

    .art-resume i:first-child {
        width: 60%;
        background: var(--brass);
    }

    .art-resume i:last-child {
        flex: 1;
        background: linear-gradient(90deg, var(--water) 50%, var(--water-soft) 50%) 100% 0 / 200% 100%;
    }

    /* Delta: forty-eight ranges, two of them changed. */
    .art-delta {
        display: grid;
        grid-template-columns: repeat(24, 1fr);
        gap: 3px;
    }

    .art-delta i {
        aspect-ratio: 1;
        border-radius: 3px;
        background: var(--line);
    }

    .art-delta .hot {
        background: var(--water);
        box-shadow: 0 0 12px var(--water);
    }

    /* Live: segments seal one after another while the last one is still open. */
    .art-live {
        display: flex;
        gap: 4px;
        height: 1.4rem;
    }

    .art-live i {
        flex: 1;
        border-radius: 4px;
        background: var(--brass);
    }

    .art-live i:last-child {
        background: var(--water);
    }

    @media (prefers-reduced-motion: no-preference) {
        .art-resume i:last-child {
            animation: fetch 2.6s ease-in-out infinite;
        }

        .art-live i:last-child {
            animation: pulse 1.2s ease-in-out infinite alternate;
        }
    }

    @keyframes fetch {
        to {
            background-position: 0 0;
        }
    }

    @keyframes pulse {
        to {
            opacity: 0.3;
        }
    }

    @media (max-width: 62rem) {
        .hero-foot {
            grid-template-columns: 1fr;
        }

        .numbers dl {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .numbers dl div {
            border-left: 0 !important;
            border-top: 1px solid var(--line);
        }

        .numbers dl div:nth-child(-n + 2) {
            border-top: 0;
        }

        .route li {
            grid-template-columns: 1fr;
        }

        .cell {
            grid-column: span 3;
        }

        .cell.wide {
            grid-column: span 6;
        }
    }

    @media (max-width: 40rem) {
        .hero::before,
        .gate-label {
            left: 80%;
        }

        .panes {
            grid-template-columns: minmax(0, 1fr);
        }

        .cell {
            grid-column: span 6;
            min-height: 0;
        }
    }
</style>
