---
// Version 3, agents and automation. The hero is a session: someone asks an agent to send a build,
// and the agent does it with the real tool calls, one after another. Below it every tool with what
// it takes and returns, the rules that keep an agent inside its folders, the one service behind
// the three front ends, and the contract a script can rely on.
//
// This version proposes its own palette and type: neutral graphite in place of the canal colours,
// violet for anything an agent does, and IBM Plex Mono for the headings. The footer is the
// project's own manifest, every key a link, the way an agent would read it.
import InstallTabs from "../../components/InstallTabs.astro";
import Cmd from "../../components/preview/Cmd.astro";
import { CLI_README, INSTALL, SPEC } from "../../data/links";
import { END_LINKS, QUICK_INSTALL, WAYS } from "../../data/preview";
import Preview from "../../layouts/Preview.astro";

const config = `{
  "mcpServers": {
    "sluice": {
      "command": "sluice",
      "args": ["mcp", "--root", "/home/me/Transfers"]
    }
  }
}`;

// The session in the hero. Field names and shapes are the server's own; the job id and the ticket
// are shortened.
const session = [
    { kind: "cmd", who: "You", text: "Send last night's build to the staging box." },
    {
        kind: "call",
        tool: "send",
        text: `{ "paths": [{ "root": "/home/me/Transfers", "path": "nightly/build.tar" }] }`,
    },
    { kind: "result", text: `{ "ok": true, "result": { "job_id": "9f2c4e71…" } }` },
    { kind: "call", tool: "job_status", text: `{ "job_id": "9f2c4e71…" }` },
    {
        kind: "result",
        text: `{ "state": "running", "bytes_done": 0, "bytes_total": 2147483648,\n  "secret_ticket": "sluice1…" }`,
    },
    { kind: "say", who: "Agent", text: "The send is ready. I passed the ticket to staging and kept it out of this chat." },
    { kind: "call", tool: "job_status", text: `{ "job_id": "9f2c4e71…" }` },
    {
        kind: "result",
        text: `{ "state": "done", "bytes_done": 2147483648, "bytes_total": 2147483648,\n  "receivers": 1 }`,
    },
    { kind: "say", who: "Agent", text: "Done. Staging has all 2.0 GiB, and every block was verified." },
];

const tools = [
    {
        name: "send",
        about: "Start sending files or folders that are inside a root, and get a job id at once.",
        takes: ["paths: [{ root, path }]", "expires_seconds?: number", "keep?: boolean"],
        gives: ["job_id"],
    },
    {
        name: "receive",
        about: "Start receiving what a ticket names into a folder inside a root. A cancelled receive resumes.",
        takes: ["ticket: string", "out: { root, path }", "force?: boolean"],
        gives: ["job_id"],
    },
    {
        name: "inspect",
        about: "Read what a ticket offers without downloading any content.",
        takes: ["ticket: string"],
        gives: ["files, folders, links, bytes", "live", "more_names", "untrusted_names: string[]"],
    },
    {
        name: "list_jobs",
        about: "List the jobs this server knows about, newest last, with state and progress.",
        takes: [],
        gives: ["jobs: Job[]"],
    },
    {
        name: "job_status",
        about: "Report one job: its state, its progress, and for a send its ticket.",
        takes: ["job_id: string"],
        gives: [
            "id, kind, state",
            "bytes_total, bytes_done",
            "receivers, resumable",
            "secret_ticket?: string",
            "untrusted_detail?: string",
        ],
    },
    {
        name: "cancel_job",
        about: "Stop a job. A receive keeps its partial store, so the same ticket resumes it.",
        takes: ["job_id: string"],
        gives: ["was_running: boolean"],
    },
    {
        name: "doctor",
        about: "Run the local checks of the Sluice home and say what each found.",
        takes: [],
        gives: ["exit_code", "checks: [{ name, state, message }]"],
    },
];

const guards = [
    {
        mark: "--root",
        title: "It works inside the folders you name",
        body: "Sends and receives happen only under a root. Every path is opened from the root's handle one component at a time, and no link is followed. With no root, every transfer is refused.",
    },
    {
        mark: "untrusted_*",
        title: "A peer's text is marked as data",
        body: "File names and failure reasons a peer chose come back only in fields whose names begin untrusted_, escaped, and never inside a sentence the tool writes.",
    },
    {
        mark: "secret_ticket",
        title: "The ticket has one home",
        body: "A send returns a job id, not a ticket. The ticket appears only in job_status under a name that says how to treat it.",
    },
    {
        mark: "stdio",
        title: "No socket, no port",
        body: "The server speaks over standard input and output and ends when its input closes. No tool can change the identity, the relay or the roots.",
    },
];

const doors = [
    { code: "sluice mcp", who: "Agents", how: "Standard input and output, in process." },
    { code: "gRPC", who: "Programs", how: "A socket or pipe that only your user can reach." },
    { code: "sluice ui", who: "People", how: "A page on 127.0.0.1 that never carries file bytes." },
    { code: "sluice send", who: "Shells", how: "Text for people, JSON lines with --json." },
];

const exits = [
    ["0", "Success", ""],
    ["2", "Usage", "A bad command line"],
    ["3", "Network", "A peer or relay could not be reached. Retrying can help"],
    ["4", "Verify", "Bytes did not match the BLAKE3 root and were discarded"],
    ["5", "Storage", "The store or the filesystem failed"],
    ["6", "Policy", "Sluice refused by rule"],
    ["70", "Bug", "A defect in Sluice, never in the environment"],
    ["130", "Cancelled", "The caller cancelled"],
];

const errorJson =
    '{"error":{"kind":"policy","message":"the store has layout version 2 and this sluice reads up to version 1. It does not write to a newer layout"}}';

const under = [
    ["Direct", "QUIC between the two machines, or through a relay you run. No storage in between."],
    ["Verified", "Each block is checked against its BLAKE3 root before it is written. A mismatch is exit code 4."],
    ["Post-quantum", "Every connection has to negotiate X25519MLKEM768, or it is closed."],
    ["Resumable", "A cancelled or killed receive keeps its verified ranges. The same ticket picks it up."],
    ["Delta", "Name an older copy with --delta-from and only the changed ranges move."],
    ["Receipts", "A signed statement of what was sent, checked offline with sluice receipt verify."],
];
---

<Preview
    title="Sluice: give your agent a way to move files"
    description="Preview, version 3: an agent sends a file through real tool calls, beside the same job as a command."
    version={3}
>
    <section class="wrap hero" aria-labelledby="v3-title">
        <div class="hero-copy">
            <h1 id="v3-title">Give your agent a way to move files.</h1>
            <p class="lede">
                Sluice sends files straight from one computer to another and verifies every block.
                The same binary is a Model Context Protocol server, a local daemon and a command
                line with a JSON contract.
            </p>
            <div class="config">
                <p>Add it to an MCP client:</p>
                <pre translate="no" tabindex="0"><code>{config}</code></pre>
            </div>
            <p class="also">
                No agent? <a href={WAYS.people.href}>Send a file from the page</a>, or
                <a href={WAYS.developers.href}>use the command line</a>.
            </p>
        </div>

        <div class="session" data-replay>
            <div class="session-bar">
                <span>session</span>
                <button class="again" type="button" data-replay-again hidden>Replay</button>
            </div>
            <ol>
                {
                    session.map((turn, at) => (
                        <li class={`turn turn-${turn.kind}`}>
                            {turn.who && <b>{turn.who}</b>}
                            {turn.tool && <b class="tool-name" translate="no">{turn.tool}</b>}
                            <span
                                class:list={{ mono: turn.kind === "call" || turn.kind === "result" }}
                                translate={turn.kind === "call" || turn.kind === "result" ? "no" : undefined}
                                data-step={at}
                                data-kind={turn.kind}>{turn.text}</span>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="wrap tools" aria-labelledby="v3-tools">
        <h2 id="v3-tools">Seven tools, one shape of answer</h2>
        <p class="lede">
            Every tool answers with <code translate="no">ok</code> and either a
            <code translate="no">result</code> or a <code translate="no">failure</code>, never
            both. A send or receive returns a job id before any file is copied.
        </p>
        <div class="tool-tabs" data-tabs>
            <div class="tool-list" role="tablist" aria-label="Tools" hidden>
                {
                    tools.map((tool, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`tool-tab-${tool.name}`}
                            aria-controls={`tool-panel-${tool.name}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            tabindex={index === 0 ? 0 : -1}
                            translate="no"
                        >
                            {tool.name}
                        </button>
                    ))
                }
            </div>
            {
                tools.map((tool) => (
                    <div
                        class="tool-panel"
                        role="tabpanel"
                        id={`tool-panel-${tool.name}`}
                        aria-labelledby={`tool-tab-${tool.name}`}
                        tabindex="0"
                    >
                        <h3 translate="no">{tool.name}</h3>
                        <p>{tool.about}</p>
                        <dl translate="no">
                            <div>
                                <dt>takes</dt>
                                <dd>{tool.takes.length ? tool.takes.map((line) => <span>{line}</span>) : <span class="none">nothing</span>}</dd>
                            </div>
                            <div>
                                <dt>gives</dt>
                                <dd>{tool.gives.map((line) => <span>{line}</span>)}</dd>
                            </div>
                        </dl>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="wrap guards" aria-labelledby="v3-guards">
        <h2 id="v3-guards">Built so an agent cannot wander</h2>
        <ul>
            {
                guards.map((guard) => (
                    <li class="guard glow rise">
                        <code translate="no">{guard.mark}</code>
                        <h3>{guard.title}</h3>
                        <p>{guard.body}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="wrap service" aria-labelledby="v3-service">
        <h2 id="v3-service">One service, four ways in</h2>
        <p class="lede">
            A local daemon holds the jobs. Every front end asks the same service to work, so a
            transfer an agent starts is one a person can watch.
        </p>
        <div class="doors">
            {
                doors.map((door) => (
                    <div class="front">
                        <code translate="no">{door.code}</code>
                        <b>{door.who}</b>
                        <p>{door.how}</p>
                    </div>
                ))
            }
            <div class="core">
                <code translate="no">sluice daemon</code>
                <p>Jobs, roots, send, receive, inspect, doctor.</p>
            </div>
        </div>
    </section>

    <section class="wrap contract" aria-labelledby="v3-contract">
        <h2 id="v3-contract">For scripts, a contract</h2>
        <p class="lede">
            The exit codes and JSON shapes are an interface. Changing one is a breaking change, and
            it is tested.
        </p>
        <div class="contract-grid">
            <div>
                <Cmd lines={["sluice inspect <ticket> --json"]} />
                <ul class="rules">
                    <li>The output never depends on whether stdout is a terminal.</li>
                    <li>With <code translate="no">--json</code>, stdout holds only JSON, one object per line.</li>
                    <li>A failure is one JSON line on stderr, and stdout stays empty.</li>
                    <li>The exit code is the same with or without <code translate="no">--json</code>.</li>
                </ul>
                <pre class="block" translate="no" tabindex="0"><code>{errorJson}</code></pre>
            </div>
            <div class="table-scroll" tabindex="0" role="group" aria-labelledby="v3-exits">
                <table>
                    <caption id="v3-exits">Exit codes</caption>
                    <thead>
                        <tr><th scope="col">Code</th><th scope="col">Kind</th><th scope="col">Meaning</th></tr>
                    </thead>
                    <tbody>
                        {
                            exits.map(([code, kind, meaning]) => (
                                <tr>
                                    <td class="code">{code}</td>
                                    <th scope="row">{kind}</th>
                                    <td>{meaning}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="note">
            The <a href={CLI_README}>CLI reference</a> has every JSON field, and the
            <a href={SPEC}>specification</a> has the wire format.
        </p>
    </section>

    <section class="wrap under" aria-labelledby="v3-under">
        <h2 id="v3-under">Under every call</h2>
        <dl class="under-list">
            {
                under.map(([term, text]) => (
                    <div class="rise">
                        <dt>{term}</dt>
                        <dd>{text}</dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <section class="wrap start" aria-labelledby="v3-start">
        <h2 id="v3-start">Install, send, receive</h2>
        <div class="start-grid">
            <div>
                <InstallTabs name="v3" options={QUICK_INSTALL} />
                <p class="note"><a href={INSTALL}>Every install channel</a>, a container image among them.</p>
            </div>
            <div class="start-cmds">
                <Cmd lines={["sluice send ./build.tar"]} />
                <Cmd lines={["sluice recv <ticket> --out ./inbox"]} />
                <Cmd lines={["sluice mcp --root ~/Transfers"]} />
            </div>
        </div>
    </section>

    <footer class="manifest" slot="end">
        <div class="wrap">
            <p class="manifest-file" translate="no">sluice.json</p>
            <nav class="manifest-body" aria-label="Everything else" translate="no">
                <span class="brace">{"{"}</span>
                <div class="pair"><span class="key">"name"</span>: <span class="str">"sluice"</span>,</div>
                <div class="pair"><span class="key">"license"</span>: <span class="str">"Apache-2.0 OR MIT"</span>,</div>
                <div class="pair"><span class="key">"telemetry"</span>: <span class="lit">null</span>,</div>
                {
                    (Object.entries(END_LINKS) as [string, readonly (readonly [string, string])[]][]).map(([group, links], gi, all) => (
                        <div class="pair group">
                            <span class="key">"{group}"</span>: <span class="brace">{"{"}</span>
                            <ul>
                                {links.map(([text, href], li) => (
                                    <li>
                                        <a href={href}><span class="key">"{text}"</span></a>{li < links.length - 1 ? "," : ""}
                                    </li>
                                ))}
                            </ul>
                            <span class="brace">{"}"}</span>{gi < all.length - 1 ? "," : ""}
                        </div>
                    ))
                }
                <span class="brace">{"}"}</span>
            </nav>
            <p class="manifest-note">
                No account to provision and nothing to sign up for before an agent can use it.
            </p>
        </div>
    </footer>
</Preview>

<script>
    import "../../scripts/replay";
</script>

<style is:global>
    /* The proposed palette. Graphite grounds, and one violet that means an agent is acting. */
    body.preview-3 {
        --basin: light-dark(#f2f3f5, #0e1012);
        --basin-deep: light-dark(#e7e9ec, #08090a);
        --stone: light-dark(#ffffff, #16191d);
        --stone-2: light-dark(#f7f8f9, #1d2126);
        --line: light-dark(#d6d9de, #262b32);
        --line-strong: light-dark(#a3a9b3, #414852);
        --ink: light-dark(#14171a, #eceef0);
        --mist: light-dark(#555c66, #9aa2ad);
        --link: var(--ink);
        --glass: light-dark(rgb(242 243 245 / 0.78), rgb(14 16 18 / 0.7));
        --agent: light-dark(#5a3fd0, #b7a8ff);
        --agent-soft: light-dark(rgb(90 63 208 / 0.07), rgb(183 168 255 / 0.08));
        --glow: var(--agent);
        --end-tint: var(--agent);
        background:
            radial-gradient(60rem 36rem at 85% -5%, var(--agent-soft), transparent 70%),
            linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 4rem,
            var(--basin);
        background-attachment: scroll;
    }

    @property --turn {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
    }
</style>

<style>
    section {
        padding-top: var(--section);
    }

    h1,
    h2 {
        font-family: var(--font-code);
        font-stretch: 100%;
        font-weight: 500;
        letter-spacing: -0.055em;
    }

    h1 {
        font-size: clamp(2.3rem, 1.1rem + 4.4vw, 4.8rem);
        line-height: 1.02;
    }

    section > h2 {
        max-width: 22ch;
        font-size: clamp(1.7rem, 1.1rem + 2.4vw, 3.1rem);
        line-height: 1.08;
    }

    h3 {
        font-stretch: 100%;
    }

    .lede {
        max-width: 58ch;
        margin-top: var(--space-2);
        color: var(--mist);
        font-size: var(--step-1);
        line-height: 1.5;
    }

    pre {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.65;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* Hero: the words on the left, the session on the right. */
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
        gap: var(--space-4);
        align-items: center;
        min-height: max(92svh, 42rem);
        padding-top: 7rem;
    }

    .config {
        max-width: 30rem;
        margin-top: var(--space-4);
    }

    .config p {
        margin-bottom: 0.5rem;
        color: var(--mist);
        font-size: var(--step--1);
    }

    .config pre {
        padding: 1rem 1.1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-m);
        background: var(--stone);
    }

    /* The session, with one light travelling round its edge. */
    .session {
        position: relative;
        border-radius: var(--radius-l);
        background: var(--stone);
        box-shadow: 0 50px 90px -50px var(--shadow-color);
    }

    .session::before {
        content: "";
        position: absolute;
        inset: 0;
        padding: 1.5px;
        border-radius: inherit;
        background: conic-gradient(from var(--turn), var(--line-strong) 0 62%, var(--agent) 82%, var(--line-strong) 100%);
        mask:
            linear-gradient(#000 0 0) content-box exclude,
            linear-gradient(#000 0 0);
        pointer-events: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .session::before {
            animation: turn 7s linear infinite;
        }
    }

    @keyframes turn {
        to {
            --turn: 360deg;
        }
    }

    .session-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 3rem;
        padding: 0.4rem 0.6rem 0.4rem 1.2rem;
        border-bottom: 1px solid var(--line);
        color: var(--mist);
        font-family: var(--font-code);
        font-size: 0.8rem;
    }

    .again {
        position: relative;
        padding: 0.3rem 0.9rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--ink);
        font: inherit;
        cursor: pointer;
    }

    .again[hidden] {
        display: none;
    }

    .session ol {
        display: grid;
        gap: 0.7rem;
        padding: 1.2rem;
    }

    .turn {
        display: grid;
        gap: 0.25rem;
    }

    .turn b {
        color: var(--mist);
        font-size: 0.78rem;
        font-weight: 600;
    }

    .turn span {
        display: block;
        min-height: 1.5em;
        line-height: 1.5;
    }

    .turn-cmd span {
        font-size: var(--step-1);
        font-weight: 600;
    }

    .mono {
        font-family: var(--font-code);
        font-size: 0.8rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .turn-call {
        padding: 0.7rem 0.9rem;
        border: 1px solid color-mix(in srgb, var(--agent) 45%, transparent);
        border-radius: var(--radius-m);
        background: var(--agent-soft);
    }

    .turn-call .tool-name {
        color: var(--agent);
        font-family: var(--font-code);
        font-size: 0.85rem;
    }

    .turn-result {
        padding-left: 0.9rem;
        border-left: 2px solid var(--line-strong);
        color: var(--mist);
    }

    .turn:has(:global(.is-waiting)) {
        opacity: 0;
    }

    .turn {
        transition: opacity 260ms ease;
    }

    /* Tools: a list of names on the left, the chosen one's shape on the right. */
    .tool-tabs {
        display: grid;
        gap: var(--space-2);
        margin-top: var(--space-4);
    }

    .tool-tabs[data-enhanced] {
        grid-template-columns: 14rem minmax(0, 1fr);
        gap: 0;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-l);
        background: var(--stone);
        overflow: hidden;
    }

    .tool-list {
        display: grid;
        align-content: start;
        padding: 0.6rem;
        border-right: 1px solid var(--line);
    }

    .tool-list[hidden] {
        display: none;
    }

    .tool-list button {
        min-height: 2.75rem;
        padding: 0.5rem 0.9rem;
        border: 0;
        border-radius: var(--radius-s);
        background: transparent;
        color: var(--mist);
        font-family: var(--font-code);
        font-size: 0.92rem;
        text-align: left;
        cursor: pointer;
    }

    .tool-list button:hover {
        color: var(--ink);
    }

    .tool-list button[aria-selected="true"] {
        background: var(--agent-soft);
        color: var(--agent);
        box-shadow: inset 2px 0 0 var(--agent);
    }

    .tool-panel {
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-m);
        background: var(--stone);
    }

    [data-enhanced] .tool-panel {
        min-height: 21rem;
        border: 0;
        border-radius: 0;
    }

    .tool-panel h3 {
        color: var(--agent);
        font-family: var(--font-code);
        font-size: var(--step-2);
        font-weight: 500;
        letter-spacing: -0.04em;
    }

    .tool-panel > p {
        max-width: 56ch;
        margin-top: 0.5rem;
        color: var(--mist);
        font-size: var(--step-1);
        line-height: 1.45;
    }

    .tool-panel dl {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-3);
        margin-top: var(--space-3);
        font-family: var(--font-code);
        font-size: 0.86rem;
    }

    .tool-panel dt {
        margin-bottom: 0.5rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--line);
        color: var(--mist);
    }

    .tool-panel dd span {
        display: block;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .tool-panel .none {
        color: var(--mist);
    }

    /* Guards */
    .guards ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
        margin-top: var(--space-4);
    }

    .guard {
        display: grid;
        gap: 0.6rem;
        align-content: start;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
