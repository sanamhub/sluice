---
// Version 6, play. The hero is a toy over moving water: files wait on this computer's side, and
// pressing one sends it across in blocks, through the gate, to the other side. Below it: four
// cards that stack as the page scrolls, each one a reason the file stays yours; the three ways to
// hold the tool; and the install box.
import InstallTabs from "../../components/InstallTabs.astro";
import Btn from "../../components/preview/Btn.astro";
import Cmd from "../../components/preview/Cmd.astro";
import End from "../../components/preview/End.astro";
import { INSTALL, REPO } from "../../data/links";
import { QUICK_INSTALL } from "../../data/preview";
import Preview from "../../layouts/Preview.astro";

const files = [
    { name: "holiday-video.mp4", size: "2.1 GB", kind: "mp4" },
    { name: "thesis-final.pdf", size: "48 MB", kind: "pdf" },
    { name: "backup.tar.zst", size: "14 GB", kind: "zst" },
    { name: "site-photos", size: "312 files", kind: "dir" },
];

const reasons = [
    {
        title: "It goes straight across",
        body: "One encrypted connection between the two computers. The file is never uploaded to a server to wait for a download.",
        fact: "QUIC, TLS 1.3, X25519MLKEM768",
    },
    {
        title: "It is checked as it lands",
        body: "Every block is verified against the file's BLAKE3 root before it is written. A damaged block is thrown away and fetched again.",
        fact: "verified 75.3 MiB",
    },
    {
        title: "It picks up where it stopped",
        body: "Close the laptop, lose the network, kill the program. The next run keeps every verified range and fetches only the rest.",
        fact: "sluice recv <ticket> --out ./inbox",
    },
    {
        title: "Nobody sits in the middle",
        body: "No account, no telemetry, no hosted storage. When two machines cannot reach each other, a relay you run forwards packets it cannot read.",
        fact: "sluice doctor --network",
    },
];

const ways = [
    {
        title: "In your browser",
        body: "A page on your own machine: pick files, show the ticket as a QR code, watch transfers move.",
        lines: ["sluice ui"],
    },
    {
        title: "In a terminal",
        body: "Two commands, pipes, JSON output and stable exit codes for scripts.",
        lines: ["sluice send ./holiday-video"],
    },
    {
        title: "Through your AI assistant",
        body: "A Model Context Protocol server in the same binary, with seven tools and no open port.",
        lines: ["sluice mcp --root ~/Transfers"],
    },
];

const words = ["No account", "No upload", "No waiting on a server", "No copy left behind", "No telemetry"];
---

<Preview
    title="Sluice: go on, send one"
    description="Preview, version 6: the hero is a toy. Press a file and watch it cross the water in blocks and land verified."
    version={6}
>
    <div class="progress" aria-hidden="true"></div>

    <section class="hero" aria-labelledby="v6-title">
        <canvas class="liquid" data-liquid aria-hidden="true"></canvas>
        <div class="wrap hero-inner">
            <div class="intro">
                <h1 id="v6-title" data-split>Go on, send one.</h1>
                <p class="lede">
                    Sluice moves files straight from one computer to another. Press a file and
                    watch what it does with it.
                </p>
                <div class="btn-row">
                    <Btn href="#v6-install">Install Sluice</Btn>
                    <Btn href={REPO} quiet>Source on GitHub</Btn>
                </div>
            </div>

            <div class="pond" data-pond>
                <div class="dock">
                    <h2>This computer</h2>
                    <ul>
                        {
                            files.map((file, at) => (
                                <li style={`--n:${at}`}>
                                    <button class="file" type="button" data-file={file.name}>
                                        <span class={`kind kind-${file.kind}`} aria-hidden="true">
                                            {file.kind}
                                        </span>
                                        <span class="name">{file.name}</span>
                                        <span class="size">{file.size}</span>
                                    </button>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="water" aria-hidden="true">
                    <i class="gate" data-gate></i>
                    <span>BLAKE3 gate</span>
                </div>

                <div class="dock dock-there">
                    <h2>Their computer</h2>
                    <ul>
                        {
                            files.map((file) => (
                                <li class="file landed" data-landed>
                                    <span class={`kind kind-${file.kind}`} aria-hidden="true">
                                        {file.kind}
                                    </span>
                                    <span class="name">{file.name}</span>
                                    <span class="size ok">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m5 12.5 4.5 4.5L19 7.5" />
                                        </svg>
                                        verified
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <p class="empty" data-empty hidden>Nothing here yet.</p>
                    <button class="again" type="button" data-again hidden>Empty this side and play again</button>
                </div>
                <p class="status" data-status aria-live="polite"></p>
            </div>
        </div>
    </section>

    <div class="marquee words" aria-hidden="true">
        {
            [0, 1].map(() => (
                <div>
                    {words.map((word) => (
                        <span>{word}</span>
                    ))}
                </div>
            ))
        }
    </div>

    <section class="wrap stack-section" aria-labelledby="v6-stack">
        <h2 id="v6-stack" data-split>Why it stays your file</h2>
        <ol class="stack">
            {
                reasons.map((reason, at) => (
                    <li style={`--i:${at}`}>
                        <div class="sheet">
                            <span class="sheet-n">{at + 1}</span>
                            <h3>{reason.title}</h3>
                            <p>{reason.body}</p>
                            <code translate="no">{reason.fact}</code>
                        </div>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="wrap ways-section" aria-labelledby="v6-ways">
        <h2 id="v6-ways" data-split>Hold it the way you like</h2>
        <ul class="ways">
            {
                ways.map((way) => (
                    <li class="glow" data-tilt="5">
                        <h3>{way.title}</h3>
                        <p>{way.body}</p>
                        <Cmd lines={way.lines} />
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="wrap install-section" id="v6-install" aria-labelledby="v6-install-title">
        <div class="install-copy">
            <h2 id="v6-install-title" data-split>Now with a real file</h2>
            <p>
                One small binary for macOS, Linux and Windows. No account to make and nothing to
                configure before the first send.
            </p>
            <p class="more"><a href={INSTALL}>Every install channel</a></p>
        </div>
        <InstallTabs name="v6" options={QUICK_INSTALL} />
    </section>

    <End
        slot="end"
        kit
        title="Your turn."
        body="Free and open source. The toy above is a drawing; the real thing is two commands."
    />
</Preview>

<script>
    import "../../scripts/kit";
    import "../../scripts/liquid";
    import "../../scripts/play";
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        min-height: max(100svh, 46rem);
        padding-block: 6rem var(--space-3);
        overflow: clip;
    }

    .liquid {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1200ms ease;
        mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    }

    .liquid[data-live] {
        opacity: 1;
    }

    .hero-inner {
        position: relative;
        display: grid;
        align-content: space-between;
        gap: var(--space-4);
    }

    .intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--space-3) var(--space-4);
        align-items: center;
    }

    h1 {
        grid-column: 1 / -1;
        font-size: clamp(3rem, 1rem + 7.4vw, 8rem);
        font-stretch: 125%;
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.055em;
    }

    .lede {
        max-width: 40ch;
        font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
        line-height: 1.4;
    }

    /* The toy: two glass docks and the water between them. */
    .pond {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(6rem, 18vw, 16rem) minmax(0, 1fr);
        align-items: stretch;
    }

    .dock {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        min-height: 19.5rem;
        padding: var(--space-2) var(--space-3) var(--space-3);
        border: 1px solid color-mix(in srgb, var(--line-strong) 70%, transparent);
        border-radius: var(--radius-l);
        background: color-mix(in srgb, var(--basin) 58%, transparent);
        box-shadow:
            inset 0 1px 0 color-mix(in srgb, var(--ink) 10%, transparent),
            0 40px 70px -40px var(--shadow-color);
        backdrop-filter: blur(20px) saturate(1.5);
        -webkit-backdrop-filter: blur(20px) saturate(1.5);
    }

    .dock h2 {
        color: var(--mist);
        font-size: var(--step--1);
        font-stretch: 100%;
        font-weight: 600;
        letter-spacing: 0;
    }

    .dock ul {
        display: grid;
        gap: 0.6rem;
    }

    .file {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.8rem;
        width: 100%;
        padding: 0.6rem 0.9rem 0.6rem 0.6rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-m);
        background: color-mix(in srgb, var(--stone) 80%, transparent);
        color: var(--ink);
        font: inherit;
        text-align: left;
    }

    button.file {
        cursor: pointer;
        transition:
            translate 260ms cubic-bezier(0.2, 0.9, 0.2, 1),
            border-color 200ms ease,
            box-shadow 260ms ease,
            opacity 300ms ease;
    }

    button.file:hover:not(:disabled) {
        translate: 0.5rem 0;
        border-color: var(--water);
        box-shadow: 0 10px 30px -12px var(--water);
    }

    button.file:active:not(:disabled) {
        translate: 0.8rem 0;
    }

    button.file:disabled {
        opacity: 0.32;
        cursor: default;
    }

    /* Each waiting file bobs a little, out of step with the next. */
    @media (prefers-reduced-motion: no-preference) {
        .dock li:has(button.file:not(:disabled)) {
            animation: bob 4.6s ease-in-out infinite;
            animation-delay: calc(var(--n) * -1.1s);
        }
    }

    @keyframes bob {
        50% {
            translate: 0 -0.22rem;
        }
    }

    .kind {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.55rem;
        background: var(--water-soft);
        color: var(--water);
        font-family: var(--font-code);
        font-size: 0.72rem;
        font-weight: 600;
    }

    .landed .kind {
        background: var(--brass-soft);
        color: var(--brass);
    }

    .name {
        font-family: var(--font-code);
        font-size: 0.92rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .size {
        color: var(--mist);
        font-size: var(--step--1);
        white-space: nowrap;
    }

    .ok {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--brass);
        font-weight: 600;
    }

    .ok svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .landed[hidden],
    .empty[hidden],
    .again[hidden] {
        display: none;
    }

    .empty {
        margin: auto;
        color: var(--mist);
    }

    .again {
        align-self: start;
        margin-top: auto;
        padding: 0.5rem 1rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: var(--step--1);
        font-weight: 600;
        cursor: pointer;
    }

    .again:hover {
        border-color: var(--brass);
    }

    .water {
        position: relative;
        display: grid;
        place-items: center;
        color: var(--brass);
        font-family: var(--font-code);
        font-size: 0.75rem;
    }

    .water::before {
        content: "";
        position: absolute;
        inset: 50% 0 auto;
        height: 2px;
        background: linear-gradient(90deg, var(--water), var(--brass));
        opacity: 0.5;
    }

    .gate {
        position: relative;
        width: 4px;
        height: 62%;
        border-radius: 4px;
        background: var(--brass);
        box-shadow: 0 0 30px 3px color-mix(in srgb, var(--brass) 60%, transparent);
    }

    .water span {
        position: absolute;
        top: 8%;
        white-space: nowrap;
    }

    .pond :global(.block) {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        width: 12px;
        height: 12px;
        margin: -6px;
        border-radius: 3px;
        background: var(--water);
        box-shadow: 0 0 12px var(--water);
        pointer-events: none;
    }

    .pond :global(.block.through) {
        background: var(--brass);
        box-shadow: 0 0 12px var(--brass);
    }

    .status {
        grid-column: 1 / -1;
        min-height: 1.6em;
        margin-top: var(--space-2);
        color: var(--mist);
        font-size: var(--step--1);
        text-align: center;
    }

    /* The line of things it does not ask for. */
    .words {
        --marquee-gap: 2.2rem;
        --marquee-time: 30s;
        padding-block: var(--space-3);
        font-size: clamp(1.6rem, 1rem + 3vw, 3.6rem);
        font-stretch: 125%;
        font-weight: 800;
        letter-spacing: -0.04em;
    }

    .words span {
        display: inline-flex;
        align-items: center;
        gap: var(--marquee-gap);
        white-space: nowrap;
    }

    .words span:nth-child(even) {
        color: transparent;
        -webkit-text-stroke: 1.5px var(--mist);
    }

    .words span::after {
        content: "";
        width: 0.34em;
        height: 0.34em;
        border-radius: 0.08em;
        background: var(--brass);
    }

    section.wrap {
        padding-top: var(--section);
    }

    section.wrap > h2,
    .install-copy h2 {
        max-width: 15ch;
        font-size: clamp(2.2rem, 1.2rem + 4.4vw, 5rem);
        font-stretch: 118%;
        font-weight: 780;
        line-height: 0.96;
        letter-spacing: -0.04em;
    }

    /* The stack: each sheet sticks a little lower than the one before, so they pile up, and the
       ones underneath shrink back as the next arrives. */
    .stack {
        display: grid;
        gap: var(--space-3);
        margin-top: var(--space-4);
    }

    .stack li {
        position: sticky;
        top: calc(5.5rem + var(--i) * 1.4rem);
    }

    .sheet {
        display: grid;
        grid-template-columns: auto minmax(0, 5fr) minmax(0, 6fr);
        gap: var(--space-2) var(--space-4);
        align-items: start;
        min-height: 19rem;
        padding: clamp(1.5rem, 4vw, 3.5rem);
        border: 1px solid var(--line-strong);
        border-radius: clamp(1.25rem, 3vw, 2.25rem);
        background: var(--stone);
        box-shadow: 0 -18px 50px -30px var(--shadow-color);
        transform-origin: 50% 0;
    }

    .stack li:nth-child(2) .sheet {
        background: color-mix(in srgb, var(--water) 16%, var(--stone));
    }

    .stack li:nth-child(3) .sheet {
        background: color-mix(in srgb, var(--brass) 16%, var(--stone));
    }

    .stack li:nth-child(4) .sheet {
        border-color: transparent;
        background: var(--ink);
        color: var(--basin);
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            .stack li:not(:last-child) .sheet {
                animation: recede linear both;
                animation-timeline: view();
                animation-range: exit-crossing 0% exit-crossing 100%;
            }
        }
    }

    @keyframes recede {
        to {
            scale: 0.9;
            opacity: 0.55;
        }
    }

    .sheet-n {
        font-family: var(--font-code);
        font-size: var(--step-1);
        opacity: 0.6;
    }

    .sheet h3 {
        font-size: clamp(1.9rem, 1.2rem + 3vw, 3.8rem);
        font-stretch: 116%;
        font-weight: 780;
        line-height: 0.95;
        letter-spacing: -0.04em;
    }

    .sheet p {
        font-size: var(--step-1);
        line-height: 1.45;
        opacity: 0.86;
    }

    .sheet code {
        grid-column: 3;
        justify-self: start;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .stack li:nth-child(4) code {
        border-color: color-mix(in srgb, var(--basin) 30%, transparent);
        background: transparent;
        color: inherit;
    }

    .ways {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-2);
        margin-top: var(--space-4);
    }

    .ways li {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        background: linear-gradient(165deg, var(--stone), color-mix(in srgb, var(--stone) 45%, transparent));
    }

    .ways h3 {
        font-size: var(--step-2);
        font-stretch: 112%;
        font-weight: 740;
        letter-spacing: -0.03em;
    }

    .ways p {
        color: var(--mist);
        line-height: 1.5;
    }

    .ways :global(.cmd) {
        margin-top: auto;
    }

    .install-section {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: var(--space-4);
        align-items: end;
        scroll-margin-top: 4rem;
    }

    .install-copy {
        display: grid;
        gap: var(--space-2);
    }

    .install-copy p {
        max-width: 38ch;
        color: var(--mist);
        font-size: var(--step-1);
        line-height: 1.45;
    }

    .install-copy .more {
        font-size: var(--step-0);
    }

    @media (max-width: 56rem) {
        .intro,
        .install-section,
        .ways {
            grid-template-columns: minmax(0, 1fr);
        }

        /* One dock above the other, and the files fall through the gate. */
        .pond {
            grid-template-columns: minmax(0, 1fr);
        }

        .dock {
            min-height: 0;
        }

        .dock-there {
            min-height: 8rem;
        }

        .water {
            height: 6.5rem;
        }

        .water::before {
            inset: 0 auto 0 50%;
            width: 2px;
            height: auto;
            background: linear-gradient(180deg, var(--water), var(--brass));
        }

        .gate {
            width: 62%;
            height: 4px;
        }

        .water span {
            top: auto;
            left: 4%;
        }

        .sheet {
            grid-template-columns: minmax(0, 1fr);
            min-height: 0;
        }

        .sheet code {
            grid-column: auto;
        }
    }
</style>
