---
// Version 5, the swarm. The hero draws a file out of thousands of points of light, sends them
// through a ring as a stream and draws the file again on the other side. Below it: the usual way
// of sending a big file beside this one, as two lanes; the rest of the tool as a reel that scrolls
// sideways; and the install box.
import InstallTabs from "../../components/InstallTabs.astro";
import Btn from "../../components/preview/Btn.astro";
import End from "../../components/preview/End.astro";
import { INSTALL, REPO } from "../../data/links";
import { FEATURES, QUICK_INSTALL } from "../../data/preview";
import Preview from "../../layouts/Preview.astro";
---

<Preview
    title="Sluice: from your disk to theirs"
    description="Preview, version 5: thousands of points of light draw a file, cross a ring as a stream and draw it again."
    version={5}
>
    <div class="progress" aria-hidden="true"></div>

    <section class="hero" aria-labelledby="v5-title">
        <div class="hero-top wrap">
            <h1 id="v5-title" data-split>From your disk to theirs.</h1>
        </div>
        <div class="swarm" data-swarm aria-hidden="true">
            <p class="tag tag-from"><b>holiday-video.mp4</b> on your computer</p>
            <p class="tag tag-to"><b>holiday-video.mp4</b> on theirs, verified</p>
        </div>
        <div class="hero-foot wrap">
            <p class="lede">
                Sluice sends files directly from one computer to another. Every block is checked as
                it lands, and nothing is stored in between.
            </p>
            <div class="btn-row">
                <Btn href="#v5-install">Install Sluice</Btn>
                <Btn href={REPO} quiet>Source on GitHub</Btn>
            </div>
        </div>
    </section>

    <section class="wrap lanes" aria-labelledby="v5-lanes">
        <h2 id="v5-lanes" data-split>One trip, not two</h2>
        <div class="lane lane-usual rise">
            <div class="lane-text">
                <h3>The usual way</h3>
                <p>The file goes up to a server, waits there as a copy, and comes down again.</p>
            </div>
            <div class="track" aria-hidden="true">
                <span class="node">You</span>
                <span class="node mid">A server keeps a copy</span>
                <span class="node">Them</span>
                <i></i>
            </div>
        </div>
        <div class="lane lane-sluice rise">
            <div class="lane-text">
                <h3>With Sluice</h3>
                <p>The file goes across once, over one encrypted connection between the two machines.</p>
            </div>
            <div class="track" aria-hidden="true">
                <span class="node">You</span>
                <span class="node">Them</span>
                <i></i><i></i><i></i><i></i>
            </div>
        </div>
    </section>

    <section class="reel-section" aria-labelledby="v5-reel">
        <div class="wrap">
            <h2 id="v5-reel" data-split>Everything else it does</h2>
        </div>
        <ul class="reel" tabindex="0" aria-label="Features, scroll sideways">
            {
                FEATURES.map((item, at) => (
                    <li class="glow" data-tilt="5">
                        <span class="reel-n">
                            {at + 1}/{FEATURES.length}
                        </span>
                        <h3>{item.title}</h3>
                        <p class="plain">{item.plain}</p>
                        <p>{item.body}</p>
                        <code translate="no">{item.code}</code>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="wrap install-section" id="v5-install" aria-labelledby="v5-install-title">
        <div class="install-copy">
            <h2 id="v5-install-title" data-split>Two minutes from here to a sent file</h2>
            <p>
                One small binary for macOS, Linux and Windows. No account to make and nothing to
                configure before the first send.
            </p>
            <p class="more"><a href={INSTALL}>Every install channel</a></p>
        </div>
        <InstallTabs name="v5" options={QUICK_INSTALL} />
    </section>

    <End
        slot="end"
        kit
        title="Send it across."
        body="Free and open source. Nothing to sign up for, and nothing left behind on a server."
    />
</Preview>

<script>
    import "../../scripts/kit";

    // The swarm needs WebGL 2 and is not fetched for a reader who asked to save data. With reduced
    // motion it draws one still frame.
    const host = document.querySelector<HTMLElement>("[data-swarm]");
    const saving = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    let able = false;
    try {
        able = document.createElement("canvas").getContext("webgl2") !== null;
    } catch {
        able = false;
    }
    if (host && able && !saving) {
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        import("../../scripts/swarm").then((scene) => scene.mount(host, still)).catch(() => {
            // The hero reads the same without it.
        });
    }
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: max(100svh, 46rem);
        padding-block: 6.5rem var(--space-4);
        background:
            radial-gradient(42% 46% at 22% 50%, var(--water-soft), transparent 70%),
            radial-gradient(42% 46% at 78% 50%, var(--brass-soft), transparent 70%);
        overflow: clip;
    }

    .hero-top,
    .hero-foot {
        position: relative;
        z-index: 1;
        display: grid;
        justify-items: center;
        text-align: center;
    }

    h1 {
        font-size: clamp(2.6rem, 1rem + 5.4vw, 5.6rem);
        font-stretch: 125%;
        font-weight: 800;
        line-height: 0.92;
        letter-spacing: -0.05em;
    }

    .swarm {
        position: absolute;
        inset: 0;
    }

    .swarm :global(canvas) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1200ms ease;
    }

    .swarm[data-live] :global(canvas) {
        opacity: 1;
    }

    /* The captions sit under the two pages. swarm.ts writes where the pages are. */
    .tag {
        position: absolute;
        top: var(--from-y, 72%);
        left: var(--from-x, 20%);
        translate: -50% 0;
        color: var(--mist);
        font-size: var(--step--1);
        text-align: center;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 900ms ease 600ms;
    }

    .swarm[data-live] .tag {
        opacity: 1;
    }

    .tag b {
        display: block;
        color: var(--water);
        font-family: var(--font-code);
        font-weight: 500;
    }

    .tag-to {
        top: var(--to-y, 72%);
        left: var(--to-x, 80%);
    }

    .tag-to b {
        color: var(--brass);
    }

    .hero-foot {
        grid-row: 3;
        gap: var(--space-3);
    }

    .lede {
        max-width: 40ch;
        font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
        line-height: 1.4;
    }

    .btn-row {
        justify-content: center;
    }

    section:not(.hero) {
        padding-top: var(--section);
    }

    h2 {
        max-width: 15ch;
        font-size: clamp(2.2rem, 1.2rem + 4.4vw, 5rem);
        font-stretch: 118%;
        font-weight: 780;
        line-height: 0.96;
        letter-spacing: -0.04em;
    }

    /* Two lanes: the trip through a server, and the trip straight across. */
    .lane {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
        gap: var(--space-4);
        align-items: center;
        margin-top: var(--space-4);
        padding: var(--space-4) var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        background: color-mix(in srgb, var(--stone) 50%, transparent);
    }

    .lane + .lane {
        margin-top: var(--space-2);
    }

    .lane-sluice {
        border-color: color-mix(in srgb, var(--brass) 55%, var(--line));
        background: linear-gradient(120deg, var(--brass-soft), transparent 60%), color-mix(in srgb, var(--stone) 70%, transparent);
    }

    .lane h3 {
        font-size: var(--step-2);
        font-stretch: 112%;
        font-weight: 740;
        letter-spacing: -0.03em;
    }

    .lane p {
        max-width: 34ch;
        margin-top: 0.5rem;
        color: var(--mist);
        line-height: 1.5;
    }

    .track {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 3rem;
        font-size: var(--step--1);
        font-weight: 600;
    }

    .track::before {
        content: "";
        position: absolute;
        inset: 50% 0 auto;
        height: 2px;
        background: var(--line-strong);
    }

    .node {
        position: relative;
        padding: 0.45rem 0.9rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
        background: var(--basin);
        white-space: nowrap;
    }

    .node.mid {
        border-style: dashed;
        color: var(--mist);
        font-weight: 500;
    }

    .track i {
        position: absolute;
        top: 50%;
        left: 3.5rem;
        width: 0.7rem;
        height: 0.7rem;
        margin-top: -0.35rem;
        border-radius: 0.18rem;
        background: var(--water);
    }

    .lane-sluice .track i {
        background: var(--brass);
        box-shadow: 0 0 14px var(--brass);
    }

    @media (prefers-reduced-motion: no-preference) {
        .lane-usual .track i {
            animation: detour 6s ease-in-out infinite;
        }

        .lane-sluice .track i {
            animation: across 1.6s linear infinite;
        }

        .lane-sluice .track i:nth-of-type(2) {
            animation-delay: -0.4s;
        }

        .lane-sluice .track i:nth-of-type(3) {
            animation-delay: -0.8s;
        }

        .lane-sluice .track i:nth-of-type(4) {
            animation-delay: -1.2s;
        }
    }

    /* Up to the server, a long wait, and down again. */
    @keyframes detour {
        0% {
            left: 3.5rem;
            opacity: 0;
        }

        6% {
            opacity: 1;
        }

        30%,
        64% {
            left: calc(50% - 6.5rem);
        }

        94% {
            opacity: 1;
        }

        100% {
            left: calc(100% - 5rem);
            opacity: 0;
        }
    }

    @keyframes across {
        0% {
            left: 3.5rem;
            opacity: 0;
        }

        12%,
        88% {
            opacity: 1;
        }

        100% {
            left: calc(100% - 5rem);
            opacity: 0;
        }
    }

    /* The reel: cards that scroll sideways and snap. Where the browser can, it adds the two
       buttons and the row of markers itself. */
    .reel {
        display: flex;
        gap: var(--space-2);
        margin-top: var(--space-4);
        padding: var(--space-2) max(var(--gutter), (100vw - var(--wrap)) / 2) var(--space-3);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: max(var(--gutter), (100vw - var(--wrap)) / 2);
        scrollbar-width: none;
        scroll-marker-group: after;
        anchor-name: --reel;
    }

    .reel::-webkit-scrollbar {
        display: none;
    }

    .reel li {
        flex: none;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        width: min(82vw, 25rem);
        min-height: 21rem;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        background: linear-gradient(165deg, var(--stone), color-mix(in srgb, var(--stone) 45%, transparent));
        scroll-snap-align: start;
    }

    .reel-n {
        color: var(--mist);
        font-family: var(--font-code);
        font-size: var(--step--1);
    }

    .reel h3 {
        margin-top: auto;
        font-size: var(--step-2);
        font-stretch: 112%;
        font-weight: 740;
        line-height: 1;
        letter-spacing: -0.03em;
    }

    .reel .plain {
        color: var(--ink);
        font-size: var(--step-1);
        line-height: 1.3;
    }

    .reel p {
        color: var(--mist);
        line-height: 1.5;
    }

    .reel code {
        align-self: start;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .reel::scroll-marker-group {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        padding-top: var(--space-1);
    }

    .reel li::scroll-marker {
        content: "";
        width: 1.6rem;
        height: 0.4rem;
        border-radius: var(--radius-pill);
        background: var(--line-strong);
    }

    .reel li::scroll-marker:target-current {
        background: var(--brass);
    }

    .reel::scroll-button(*) {
        position: fixed;
        position-anchor: --reel;
        width: 3rem;
        height: 3rem;
        border: 1px solid var(--line-strong);
        border-radius: 50%;
        background: var(--stone);
        color: var(--ink);
        font-size: 1.2rem;
        cursor: pointer;
    }

    .reel::scroll-button(*):disabled {
        opacity: 0.35;
        cursor: default;
    }

    .reel::scroll-button(left) {
        content: "\2190" / "Scroll back";
        bottom: calc(anchor(top) + 0.5rem);
        right: calc(max(var(--gutter), (100vw - var(--wrap)) / 2) + 3.6rem);
    }

    .reel::scroll-button(right) {
        content: "\2192" / "Scroll on";
        bottom: calc(anchor(top) + 0.5rem);
        right: max(var(--gutter), (100vw - var(--wrap)) / 2);
    }

    .install-section {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: var(--space-4);
        align-items: end;
        scroll-margin-top: 4rem;
    }

    .install-copy {
        display: grid;
        gap: var(--space-2);
    }

    .install-copy p {
        max-width: 38ch;
        color: var(--mist);
        font-size: var(--step-1);
        line-height: 1.45;
    }

    .install-copy .more {
        font-size: var(--step-0);
    }

    @media (max-width: 56rem) {
        /* On a narrow screen the swarm gets a block of its own between the headline and the
           buttons, wider than it is tall, so the two pages still stand side by side. */
        .hero {
            grid-template-rows: auto auto auto;
            min-height: 0;
            gap: var(--space-3);
        }

        .swarm {
            position: relative;
            inset: auto;
            grid-row: 2;
            height: 21rem;
            margin-bottom: 2.5rem;
        }

        .tag {
            max-width: 7.5rem;
            white-space: normal;
        }

        .tag b {
            font-size: 0.72rem;
            white-space: nowrap;
        }

        .lane,
        .install-section {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-3);
        }

        .node.mid {
            font-size: 0.75rem;
        }
    }
</style>
