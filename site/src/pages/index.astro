---
import Compare from "../components/Compare.astro";
import Doors from "../components/Doors.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import InstallAll from "../components/InstallAll.astro";
import Relay from "../components/Relay.astro";
import Security from "../components/Security.astro";
import Send from "../components/Send.astro";
import Tasks from "../components/Tasks.astro";
import Base from "../layouts/Base.astro";
---

<Base
    title="Sluice: send a file straight to another computer"
    description="Sluice sends a file or a folder straight from one computer to another, checks every block as it lands, and keeps no copy in between. No account, no size plan."
>
    <Hero />
    <Doors />
    <Send />
    <HowItWorks />
    <Tasks mode="people" />
    <Compare />
    <Security />
    <Relay />
    <InstallAll />
    <Faq />
</Base>
