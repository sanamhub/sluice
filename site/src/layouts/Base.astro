---
// The shell both pages share: head, header, footer. No script is loaded anywhere in the site, so
// this layout has no client-side behaviour at all.
import { REPO, SECURITY, LICENSES } from "../data/links";
import { SITE_URL } from "../site";
import Fonts from "../components/Fonts.astro";
import "../styles/site.css";

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImage = new URL("/og.png", SITE_URL);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? (
            <meta name="robots" content="noindex" />
        ) : (
            <link rel="canonical" href={canonical} />
        )}
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fonts />
        <meta name="theme-color" content="#070b10" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
        {!noindex && (
            <>
                <meta property="og:type" content="website" />
                <meta property="og:title" content={title} />
                <meta property="og:description" content={description} />
                <meta property="og:url" content={canonical} />
                <meta property="og:image" content={ogImage} />
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
                <meta name="twitter:card" content="summary_large_image" />
            </>
        )}
    </head>
    <body>
        <a class="skip" href="#main">
            Skip to content
        </a>
        <header class="top">
            <div class="wrap top-inner">
                <a class="brand" href="/">
                    <img src="/sluice.svg" alt="" width="26" height="26" />
                    <span>Sluice</span>
                </a>
                <nav class="top-nav" aria-label="Project">
                    <a href="/#how">How it works</a>
                    <a href={REPO}>GitHub</a>
                </nav>
            </div>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="foot">
            <div class="wrap foot-inner">
                <p class="foot-note">
                    Pre-1.0. License <span class="mono">Apache-2.0 OR MIT</span>. No analytics, no
                    cookies, and no request to another origin.
                </p>
                <nav class="foot-nav" aria-label="Footer">
                    <a href={REPO}>GitHub</a>
                    <a href={SECURITY}>Security</a>
                    <a href={LICENSES}>License</a>
                </nav>
            </div>
        </footer>
    </body>
</html>
