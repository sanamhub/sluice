---
// The shell both pages share: head, header and footer. The page works with no script at all;
// the scripts add the theme button, the install tabs and the hero scene.
import {
    ADRS,
    CHANGELOG,
    CONTRIBUTING,
    DESIGN,
    LICENSES,
    RELEASES,
    REPO,
    ROADMAP,
    SECURITY,
    SPEC,
    THREAT_MODEL,
    installAt,
} from "../data/links";
import { SITE_URL } from "../site";
import Fonts from "../components/Fonts.astro";
import Logo from "../components/Logo.astro";
import "../styles/site.css";

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImage = new URL("/og.png", SITE_URL);

const columns = [
    {
        title: "Install",
        links: [
            ["Shell installer", installAt("shell-installer")],
            ["PowerShell", installAt("powershell-installer")],
            ["Homebrew", installAt("homebrew")],
            ["Scoop and winget", installAt("scoop")],
            ["Container image", installAt("the-sluice-image")],
            ["From source", installAt("from-source")],
        ],
    },
    {
        title: "Learn",
        links: [
            ["How it works", "/#how"],
            ["Design", DESIGN],
            ["Specification", SPEC],
            ["Threat model", THREAT_MODEL],
            ["Decision records", ADRS],
        ],
    },
    {
        title: "Project",
        links: [
            ["Source on GitHub", REPO],
            ["Releases", RELEASES],
            ["Changelog", CHANGELOG],
            ["Roadmap", ROADMAP],
            ["Contributing", CONTRIBUTING],
            ["Report a vulnerability", SECURITY],
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script src="/theme.js" is:inline></script>
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <Fonts />
        <meta name="theme-color" content="#081820" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#eef3f1" media="(prefers-color-scheme: light)" />
        {
            !noindex && (
                <>
                    <meta property="og:type" content="website" />
                    <meta property="og:title" content={title} />
                    <meta property="og:description" content={description} />
                    <meta property="og:url" content={canonical} />
                    <meta property="og:image" content={ogImage} />
                    <meta property="og:image:width" content="1200" />
                    <meta property="og:image:height" content="630" />
                    <meta
                        property="og:image:alt"
                        content="Send huge files straight to another computer. Nothing is stored in between."
                    />
                    <meta name="twitter:card" content="summary_large_image" />
                </>
            )
        }
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <header class="top">
            <div class="wrap top-inner">
                <a class="brand" href="/" aria-label="Sluice, home">
                    <Logo />
                    <span>Sluice</span>
                </a>
                <nav class="top-nav" aria-label="Main">
                    <a href="/#how">How it works</a>
                    <a href="/#install">Install</a>
                    <a href="/#security">Security</a>
                    <a class="top-repo" href={REPO}>
                        <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
                            ><path
                                fill="currentColor"
                                d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
                            ></path></svg
                        >
                        <span>GitHub</span>
                    </a>
                    <button class="theme-toggle" type="button" data-theme-toggle hidden>
                        <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
                            ><path
                                fill="currentColor"
                                d="M20.7 14.6A8.6 8.6 0 0 1 9.4 3.3a.6.6 0 0 0-.8-.7 9.8 9.8 0 1 0 12.8 12.8.6.6 0 0 0-.7-.8Z"
                            ></path></svg
                        >
                        <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
                            ><circle cx="12" cy="12" r="4.4" fill="currentColor"></circle><path
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
                            ></path></svg
                        >
                    </button>
                </nav>
            </div>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="foot">
            <div class="wrap foot-grid">
                <div class="foot-brand">
                    <a class="brand" href="/" aria-label="Sluice, home">
                        <Logo />
                        <span>Sluice</span>
                    </a>
                    <p>
                        Files go straight from one computer to another, checked block by block. Free
                        and open source under <a href={LICENSES}>Apache-2.0 or MIT</a>.
                    </p>
                    <p class="muted">No analytics, no cookies, and no request to another origin.</p>
                </div>
                {
                    columns.map((column) => (
                        <nav class="foot-col" aria-label={column.title}>
                            <h2>{column.title}</h2>
                            <ul>
                                {column.links.map(([text, href]) => (
                                    <li>
                                        <a href={href}>{text}</a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    ))
                }
            </div>
            <div class="foot-art" aria-hidden="true"></div>
            <div class="foot-band">
                <div class="wrap foot-band-inner">
                    <p>Copyright 2026 the Sluice contributors.</p>
                    <p><a href={RELEASES}>Releases and checksums</a></p>
                </div>
            </div>
        </footer>
        <script>
            import "../scripts/theme-toggle";
        </script>
    </body>
</html>
