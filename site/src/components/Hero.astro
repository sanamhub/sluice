---
import { BREW, POWERSHELL_BY_HAND, SCOOP, SHELL } from "../data/install";
import { INSTALL, REPO } from "../data/links";
import HeroStill from "./HeroStill.astro";
import InstallTabs from "./InstallTabs.astro";

const quick = [
    { id: "unix", label: "macOS and Linux", commands: [{ lines: SHELL }] },
    { id: "windows", label: "Windows", commands: [{ lines: SCOOP }, POWERSHELL_BY_HAND] },
    { id: "brew", label: "Homebrew", commands: [{ lines: BREW }] },
];
---

<section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
        <div class="hero-copy">
            <h1 id="hero-title">Send big files straight to another computer.</h1>
            <p class="lede">
                Sluice opens a direct channel between two machines and checks every block as it
                lands. Nothing waits on a server in between, and there is no account to make.
            </p>
            <InstallTabs name="hero" options={quick} />
            <p class="hero-more">
                Also <a href="#install">Scoop, winget, the AUR, a container image</a>{" "}
                and <a href={INSTALL}>source</a>. Free and open source, on <a href={REPO}>GitHub</a>.
            </p>
        </div>
        <div class="hero-art" data-hero-scene>
            <HeroStill />
        </div>
    </div>
</section>

<script>
    import "../scripts/hero";
</script>
