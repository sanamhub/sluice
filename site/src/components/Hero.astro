---
// The first screen. The action is the page a person can use today, not a command to paste: the
// steps behind it are one click away, and a reader who wants the command line has its own door.
import { ROADMAP } from "../data/links";
import HeroStill from "./HeroStill.astro";
import Btn from "./preview/Btn.astro";
---

<section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
        <div class="hero-copy">
            <h1 id="hero-title">Send a file straight to another computer.</h1>
            <p class="lede">
                Sluice opens a channel between the two machines and checks every block as it lands.
                Nothing waits on a server in between, there is no account to make, and no copy is
                left behind.
            </p>
            <div class="hero-actions">
                <Btn href="#send">Send a file now</Btn>
                <Btn href="#install" quiet>Install Sluice</Btn>
            </div>
            <p class="hero-more">
                A desktop app, and sending from a browser with nothing installed, are
                <a href={ROADMAP}>coming</a>. Free and open source, and it never phones home.
            </p>
        </div>
        <div class="hero-art" data-hero-scene>
            <HeroStill />
        </div>
    </div>
</section>

<style>
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-3);
    }
</style>

<script>
    import "../scripts/hero";
</script>
