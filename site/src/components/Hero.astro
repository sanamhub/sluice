---
import { REPO } from "../data/links";
import HeroArt from "./HeroArt.astro";
---

<section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
        <div class="hero-copy">
            <h1 id="hero-title">Send huge files straight to another computer.</h1>
            <p class="lede">
                Nothing is stored in between. Sluice moves the file directly and checks every block
                as it lands.
            </p>
            <p class="status">
                <span class="status-mark" aria-hidden="true"></span>
                In development, pre-1.0
            </p>
            <p class="hero-today">
                Today it names this computer, checks your setup and prints shell completions. Sending
                and receiving arrive in 1.0.
            </p>
            <div class="actions">
                <a class="button primary" href={REPO}>
                    View on GitHub
                </a>
                <a class="button" href="#how">
                    See how it works
                </a>
            </div>
        </div>
        <div class="hero-art">
            <HeroArt />
        </div>
    </div>
</section>
