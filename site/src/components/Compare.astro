---
// Sluice next to the usual upload-then-download flow. The comparison names no product, so the cloud
// column says "usually" where services differ.
const rows = [
    ["Where the file waits", "Nowhere. It goes to the other computer.", "On the provider's servers."],
    ["Account", "None.", "Usually one, sometimes for both people."],
    ["Size limit", "None from Sluice. The disks decide.", "Usually set by a plan."],
    ["Checked on arrival", "Every block, against the root the ticket names.", "The provider checks its own copy."],
    ["After a dropped link", "The receive keeps what it checked and fetches the rest.", "Often from the start, unless the service resumes."],
    ["Who can read it", "The two machines. The link is encrypted end to end.", "The provider, and anyone with the share link."],
];
---

<section class="section compare" aria-labelledby="compare-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="compare-title">Not another upload</h2>
            <p>Sluice is not a storage service. The middle of the path keeps nothing.</p>
        </div>
        <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Question</span></th>
                        <th scope="col">Sluice</th>
                        <th scope="col">Upload, then download</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        rows.map(([label, sluice, cloud]) => (
                            <tr>
                                <th scope="row">{label}</th>
                                <td>{sluice}</td>
                                <td>{cloud}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
