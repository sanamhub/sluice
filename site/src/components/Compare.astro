---
// Sluice next to the tools people already use. The cells and their sources live in data/compare.ts;
// a cell that the other tool's documentation does not cover says so instead of guessing.
import { CHECKED, NOT_STATED, ROWS, TOOLS } from "../data/compare";

const sources = TOOLS.flatMap((tool) => tool.sources);
---

<section class="section compare" aria-labelledby="compare-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="compare-title">Next to the tools you know</h2>
            <p>
                Sluice is closest to croc and magic-wormhole, and it is not a storage service. Each
                cell about another tool comes from that tool's own documentation.
            </p>
        </div>
        <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Question</span></th>
                        {TOOLS.map((tool) => <th scope="col">{tool.name}</th>)}
                    </tr>
                </thead>
                <tbody>
                    {
                        ROWS.map(([label, ...cells]) => (
                            <tr>
                                <th scope="row">{label}</th>
                                {cells.map((cell) => (
                                    <td class:list={{ unstated: cell === NOT_STATED }}>{cell}</td>
                                ))}
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
        <p class="note compare-sources">
            Read on {CHECKED} from
            {
                sources.map((source, at) => (
                    <>
                        {at > 0 && (at === sources.length - 1 ? " and " : ", ")}
                        <a href={source.href}>{source.label}</a>
                    </>
                ))
            }. Names belong to their owners. Something out of date? Open an issue.
        </p>
    </div>
</section>
