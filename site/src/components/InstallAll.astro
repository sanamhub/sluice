---
// Every channel 0.1.0 ships, in the same tabs as the hero.
import { AUR, BREW, DOCKER, POWERSHELL_BY_HAND, SCOOP, SHELL, SOURCE, WINGET } from "../data/install";
import { INSTALL } from "../data/links";
import InstallTabs from "./InstallTabs.astro";

const channels = [
    { id: "shell", label: "Shell", commands: [{ lines: SHELL }], note: "Linux and macOS, x86-64 and ARM64." },
    {
        id: "powershell",
        label: "PowerShell",
        commands: [{ ...POWERSHELL_BY_HAND, caption: "Select the line to copy it." }],
        note: "Windows, x86-64 and ARM64.",
    },
    { id: "brew", label: "Homebrew", commands: [{ lines: BREW }], note: "macOS and Linux." },
    { id: "scoop", label: "Scoop", commands: [{ lines: SCOOP }], note: "Windows." },
    { id: "winget", label: "winget", commands: [{ lines: WINGET }], note: "Windows." },
    { id: "aur", label: "AUR", commands: [{ lines: AUR }], note: "Arch Linux, x86-64 and ARM64." },
    {
        id: "docker",
        label: "Docker",
        commands: [{ lines: DOCKER }],
        note: "Linux, amd64 and arm64. The home lives on a volume.",
    },
    {
        id: "source",
        label: "Source",
        commands: [{ lines: SOURCE }],
        note: "Any of the six targets, with Rust 1.91 or newer.",
    },
];
---

<section class="section install-all" id="install" aria-labelledby="install-title">
    <div class="wrap install-grid">
        <div class="section-head">
            <h2 id="install-title">Install</h2>
            <p>
                One binary for Linux, macOS and Windows, on x86-64 and ARM64. The
                <a href={INSTALL}>install guide</a> shows how to verify each download, upgrade and
                uninstall.
            </p>
        </div>
        <InstallTabs name="all" options={channels} />
    </div>
</section>
