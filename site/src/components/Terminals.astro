---
import { CLI_README } from "../data/links";

// The left block is a sketch of the 1.0 output and says so. The right block is what
// `sluice doctor` prints, copied from a run on a fresh home with the home path changed to the
// example one; nothing in it is invented.
const preview = [
    "$ sluice send ./render.mov",
    "sluice1k4t…                      24.0 GB",
    "",
    "$ sluice recv sluice1k4t… -o ./render.mov",
    "9.6 GB of 24.0 GB   40%   block 585,937 verified",
];

const doctor = [
    "ok       version    sluice 0.1.0 for x86_64-unknown-linux-gnu, running on linux",
    "ok       home       /home/you/.local/share/sluice, from SLUICE_HOME",
    "ok       access     only this user can reach the home",
    "ok       layout     version 1",
    "ok       lock       free",
    "ok       key        32 bytes, readable only by this user",
    "ok       space      7.7 GiB free (8307675136 bytes)",
    "skipped  transport  the transport checks are not built yet",
];
---

<section class="section" id="terminal" aria-labelledby="terminal-title">
    <div class="wrap">
        <div class="plate">
            <div class="section-grid">
                <div class="section-side">
                    <h2 id="terminal-title">The command line</h2>
                </div>
                <div class="section-main">
                    <p class="section-lede">
                        Three commands work today: <code>id</code>, <code>doctor</code> and{" "}
                        <code>completions</code>. <code>send</code> and <code>recv</code> are 1.0
                        and do not exist yet. The <a href={CLI_README}>CLI README</a> lists every
                        check, exit code and JSON field.
                    </p>

                    <div class="terminals">
                        <div class="panel">
                            <div class="panel-head">
                                <span class="panel-label">send and recv</span>
                                <span class="tag">Preview of 1.0</span>
                            </div>
                            <pre
                                class="term"
                                aria-label="A sketch of the 1.0 send and recv output"
                            ><code>{preview.map((line, i) => <span class="line" style={`--i: ${i}`}>{line || " "}</span>)}</code></pre>
                            <p class="panel-note muted">
                                A sketch of the 1.0 output, not a recording.
                            </p>
                        </div>

                        <div class="panel">
                            <div class="panel-head">
                                <span class="panel-label">doctor</span>
                                <span class="tag live">Working today</span>
                            </div>
                            <pre
                                class="term"
                                aria-label="Real sluice doctor output on a fresh home"
                            ><code>{doctor.join("\n")}</code></pre>
                            <p class="panel-note muted">
                                Real output on a fresh home. The home path is the example one.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
