---
// The closing block of every preview: one action, the link columns and the name at full width.
import {
    ADRS,
    CHANGELOG,
    CLI_README,
    DESIGN,
    INSTALL,
    LICENSES,
    PERFORMANCE,
    RELAY_README,
    RELEASES,
    REPO,
    ROADMAP,
    SECURITY,
    SPEC,
    THREAT_MODEL,
} from "../../data/links";

interface Props {
    title: string;
    body: string;
}

const { title, body } = Astro.props;

const columns = [
    {
        title: "Use",
        links: [
            ["Install guide", INSTALL],
            ["Every command", CLI_README],
            ["Run a relay", RELAY_README],
            ["Releases", RELEASES],
        ],
    },
    {
        title: "Understand",
        links: [
            ["Design", DESIGN],
            ["Specification", SPEC],
            ["Performance", PERFORMANCE],
            ["Threat model", THREAT_MODEL],
            ["Decision records", ADRS],
        ],
    },
    {
        title: "Project",
        links: [
            ["Source on GitHub", REPO],
            ["Changelog", CHANGELOG],
            ["Roadmap", ROADMAP],
            ["Report a vulnerability", SECURITY],
        ],
    },
];
---

<footer class="end">
    <div class="wrap end-call">
        <h2>{title}</h2>
        <p>{body}</p>
        <div class="end-actions">
            <a class="button primary" href={INSTALL}>Install Sluice</a>
            <a class="button" href={REPO}>Source on GitHub</a>
        </div>
    </div>
    <div class="wrap end-cols">
        {
            columns.map((column) => (
                <nav aria-label={column.title}>
                    <h3>{column.title}</h3>
                    <ul>
                        {column.links.map(([text, href]) => (
                            <li>
                                <a href={href}>{text}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>
    <p class="end-name" aria-hidden="true">sluice</p>
    <div class="end-base">
        <div class="wrap">
            <p>
                Free and open source under <a href={LICENSES}>Apache-2.0 or MIT</a>. No analytics,
                no cookies.
            </p>
            <p>A preview of a direction. The live page is at <a href="/">sluicedrop.com</a>.</p>
        </div>
    </div>
</footer>
