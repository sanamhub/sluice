---
// Astro's font API only writes the @font-face rules and the preloads for the families a page
// renders with <Font>. The two families are declared in fonts.mjs; this puts them in the head.
// Instrument Sans paints the first paragraph, so it is the one preloaded.
import { Font } from "astro:assets";
---

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />
