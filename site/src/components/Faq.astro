---
import { CONTRIBUTING, ROADMAP } from "../data/links";
import Prose from "./Prose.astro";

const questions = [
    {
        q: "Is it free?",
        a: "Yes. The code is Apache-2.0 or MIT. You pay only for your machines and for a relay if you run one.",
    },
    {
        q: "Does it work over the internet, or only at home?",
        a: "Both. On one network the machines connect directly. Across the internet they try a direct path first, through the routers. Machines behind strict routers need a relay to meet at: your own, or n0's public relays with `--n0-relays`.",
    },
    {
        q: "Who can see my files?",
        a: "Only the two machines keep them. The connection is encrypted, and a relay passes packets it cannot read. The ticket is the key: anyone who has it can fetch the content while the sender is serving and the ticket has not expired.",
    },
    {
        q: "What happens if the connection drops?",
        a: "Run the same `recv` again. The receive kept the blocks it had checked, so it fetches only the rest. No unverified byte is ever written.",
    },
    {
        q: "How big can a file be?",
        a: "Sluice sets no limit. The sender reads files where they are and the receiver writes as blocks arrive, so the disks are the limit.",
    },
    {
        q: "Is there an app with a window?",
        a: "Not yet. 0.1.0 is the command-line tool and the two container images. Desktop and browser clients are on the roadmap.",
    },
    {
        q: "How can I help?",
        a: "Try it and say what happens, especially what `sluice doctor --network` prints on unusual networks. Issues, questions and pull requests are all welcome.",
    },
];
---

<section class="section faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
        <div class="section-head">
            <h2 id="faq-title">Questions</h2>
            <p>
                The <a href={ROADMAP}>roadmap</a> says what comes next, and
                <a href={CONTRIBUTING}>contributing</a> says how to help.
            </p>
        </div>
        <div class="faq-list">
            {
                questions.map((item) => (
                    <details class="faq-item">
                        <summary>{item.q}</summary>
                        <p>
                            <Prose text={item.a} />
                        </p>
                    </details>
                ))
            }
        </div>
    </div>
</section>
