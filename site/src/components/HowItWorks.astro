---
import StepArt from "./StepArt.astro";

// The three steps are a real sequence, so they are numbered and ordered. Every capability they
// name is 1.0: send and recv, the ticket, verified blocks and resume.
const steps = [
    {
        kind: "send" as const,
        title: "Send a file",
        body: "Pick a file or a folder. Sluice reads it where it is, so a large file needs no second copy before it moves.",
        note: "1.0: send, folders, reference in place",
    },
    {
        kind: "share" as const,
        title: "Share one code",
        body: "Send prints a ticket: one line of text with the address and the file's fingerprint. Send it however you like. Keep it private, because anyone who has it can fetch the file.",
        note: "1.0: the ticket",
    },
    {
        kind: "receive" as const,
        title: "Receive it",
        body: "Paste the ticket on the other computer. Every block is checked before it is written, and a dropped link resumes at the last checked block.",
        note: "1.0: verified blocks, resume",
    },
];
---

<section class="section steps" id="how" aria-labelledby="how-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="how-title">How it works</h2>
            <p class="section-lede">
                Three steps, one file, and no stop in the middle. All three arrive in 1.0; today you
                can check an install with <code>sluice doctor</code>.
            </p>
        </div>

        <ol class="step-list">
            {steps.map((step, index) => (
                <li class="step">
                    <div class="step-top">
                        <span class="step-number" aria-hidden="true">
                            {String(index + 1).padStart(2, "0")}
                        </span>
                        <StepArt kind={step.kind} />
                    </div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                    <p class="step-note mono">{step.note}</p>
                </li>
            ))}
        </ol>
    </div>
</section>
