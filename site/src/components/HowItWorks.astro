---
// The three things that happen in a transfer, in order. The line beside them fills with water as
// the reader scrolls, and each step's mark turns brass when the water reaches it.
import { DESIGN, IROH, IROH_BLOBS } from "../data/links";
import Prose from "./Prose.astro";

const steps = [
    {
        title: "The sender prints a ticket",
        body: "`sluice send` reads the files where they are, cuts them into blocks and hashes them. The ticket names this machine, the addresses it can be reached at and the content's root. It carries no file names, and it expires in a day unless you say otherwise.",
        code: "sluice send ./holiday-video",
    },
    {
        title: "The two machines find a path",
        body: "The receiver dials the sender over QUIC with TLS 1.3. On one network they connect directly. Across the internet they punch a hole through the routers, and a relay you name with `--relay` only carries the bytes if no direct path works.",
        code: "sluice recv <ticket> --out ./inbox",
    },
    {
        title: "Every block is checked before it is written",
        body: "Each block is verified against the BLAKE3 root the ticket named. A block that does not match is thrown away, so a damaged transfer fails at that block, not after the file is opened. A dropped receive keeps what it checked and fetches only the rest.",
        code: "verified 75.3 MiB",
    },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
    <div class="wrap how-grid">
        <div class="section-head how-head">
            <h2 id="how-title">How a file crosses</h2>
            <p>
                Three steps and no stop in the middle. Sluice builds on <a href={IROH}>iroh</a> for the
                connection and <a href={IROH_BLOBS}>iroh-blobs</a> for verified storage; the
                <a href={DESIGN}>design notes</a> have the rest.
            </p>
        </div>
        <ol class="how-steps">
            {
                steps.map((step, index) => (
                    <li class="how-step">
                        <span class="how-mark" aria-hidden="true">
                            {index + 1}
                        </span>
                        <h3>{step.title}</h3>
                        <p>
                            <Prose text={step.body} />
                        </p>
                        <code translate="no">{step.code}</code>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
