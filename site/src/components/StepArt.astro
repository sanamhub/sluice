---
// One small drawing for each step. The drawings are aria-hidden; the step text carries the
// meaning. They are line work on the same grid as the rest of the page, and they do not move.
interface Props {
    kind: "send" | "share" | "receive";
}

const { kind } = Astro.props;
---

<svg
    class={`step-art step-art-${kind}`}
    viewBox="0 0 132 88"
    aria-hidden="true"
    focusable="false"
>
    {kind === "send" && (
        <>
            <path class="art-rule" d="M8 18h34l10 10v42H8z" />
            <path class="art-rule faint" d="M14 12h34l10 10v42" />
            <path class="art-rule faint" d="M20 6h34l10 10v42" />
            <path class="art-accent" d="M58 44h48" />
            <path class="art-accent" d="M98 38l8 6-8 6" />
        </>
    )}
    {kind === "share" && (
        <>
            <rect class="art-rule" x="14" y="18" width="104" height="52" />
            <path class="art-accent" d="M26 32h44" />
            <path class="art-rule" d="M26 42h68" />
            <path class="art-rule" d="M26 50h52" />
            <path class="art-dash" d="M78 28v32" />
            <path class="art-rule" d="M92 32h14M92 42h14M92 52h14" />
        </>
    )}
    {kind === "receive" && (
        <>
            <path class="art-rule" d="M14 18h52l10 10v42H14z" />
            <path class="art-rule" d="M14 40h72" />
            <path class="art-rule" d="M14 50h44" />
            <path class="art-accent" d="M76 30l8 8 14-18" />
            <path class="art-accent" d="M96 48v14M102 48v14M108 48v14" />
        </>
    )}
</svg>
