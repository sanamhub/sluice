---
// The hero drawing: a file leaves one computer, crosses a direct path, and is checked on the other
// side. The relay is a dim side loop because it is only used when you run one and a direct path
// fails. Every moving part is CSS; the drawing is aria-hidden and the caption says what it shows.
const verticals = Array.from({ length: 10 }, (_, i) => 20 + i * 40);
const horizontals = Array.from({ length: 11 }, (_, i) => 20 + i * 40);
const checks = Array.from({ length: 9 }, (_, i) => i);
const checkX = (i: number) => 300 + (i % 3) * 16;
const checkY = (i: number) => 360 + Math.floor(i / 3) * 16;
---

<figure class="figure">
    <div class="hero-frame">
        <svg
            class="hero-svg"
            viewBox="0 0 420 470"
            aria-hidden="true"
            focusable="false"
            preserveAspectRatio="xMidYMid meet"
        >
            <defs>
                <clipPath id="hero-path">
                    <rect x="198" y="150" width="24" height="170" />
                </clipPath>
            </defs>

            <g class="grid">
                {verticals.map((x) => (
                    <line x1={x} y1="20" x2={x} y2="450" />
                ))}
                {horizontals.map((y) => (
                    <line x1="20" y1={y} x2="400" y2={y} />
                ))}
            </g>

            <path class="relay" d="M210 150 C 96 178, 96 292, 210 320" />
            <rect class="relay-node" x="90" y="229" width="12" height="12" />
            <text class="relay-label" x="96" y="216">
                relay
            </text>

            <g class="peer">
                <rect class="peer-box" x="60" y="34" width="300" height="116" />
                <rect class="screen" x="80" y="50" width="20" height="14" />
                <path class="stand" d="M86 64v4h8v-4" />
                <text class="peer-label" x="110" y="61">
                    this computer
                </text>
                <path class="file" d="M80 84h11l4 4v13H80z" />
                <text class="file-name" x="102" y="95">
                    render.mov
                </text>
                <text class="file-meta" x="102" y="111">
                    24.0 GB
                </text>
            </g>

            <g class="peer">
                <rect class="peer-box" x="60" y="320" width="300" height="116" />
                <rect class="screen" x="80" y="336" width="20" height="14" />
                <path class="stand" d="M86 350v4h8v-4" />
                <text class="peer-label" x="110" y="347">
                    their computer
                </text>
                <path class="file" d="M80 370h11l4 4v13H80z" />
                <text class="file-name" x="102" y="381">
                    render.mov
                </text>
                <text class="file-meta" x="102" y="397">
                    24.0 GB
                </text>
            </g>

            <g class="checks">
                {checks.map((i) => (
                    <rect
                        class="check"
                        style={`--i: ${i}`}
                        x={checkX(i)}
                        y={checkY(i)}
                        width="12"
                        height="12"
                    />
                ))}
            </g>
            <text class="check-label" x="300" y="424">
                checked
            </text>

            <g class="wires">
                <line class="path solid" x1="210" y1="150" x2="210" y2="320" />
                <line class="path broken" x1="210" y1="150" x2="210" y2="320" />
                <g class="drop-mark">
                    <path d="M203 244 l14 14 M217 244 l-14 14" />
                </g>
            </g>

            <g clip-path="url(#hero-path)">
                <g class="stream">
                    <rect class="chunk" x="201" y="150" width="18" height="18" />
                    <rect class="chunk" x="201" y="174" width="18" height="18" />
                    <rect class="chunk" x="201" y="198" width="18" height="18" />
                    <rect class="chunk" x="201" y="222" width="18" height="18" />
                </g>
            </g>

            <text class="path-label" x="222" y="248">
                direct, encrypted
            </text>
            <text class="still-note" x="222" y="266">
                link drops once; resumes here
            </text>
        </svg>
    </div>
    <figcaption class="caption">
        A file leaves this computer and crosses a direct encrypted path. Each block is checked on
        the other side. The relay stays dim: it carries bytes only if you run one and a direct path
        fails.
    </figcaption>
</figure>
