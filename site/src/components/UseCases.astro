---
// Four concrete jobs, each naming the 1.0 feature it leans on. No sizes, because no transfer has
// been measured yet and an example number would read like a claim.
const cases = [
    {
        title: "A day of footage",
        body: "A video editor sends the day's camera files to a colourist on the same network. The files go straight across, so there is no upload to wait for.",
        feature: "Direct path, verified blocks",
    },
    {
        title: "A database backup",
        body: "A nightly dump goes to a server in another building. Every block is checked as it lands, and a dropped link picks up at the last checked block.",
        feature: "Resume, verified blocks",
    },
    {
        title: "A recording, still growing",
        body: "A sound engineer shares a session while it is still being recorded. The other side can read up to the last segment that checks out.",
        feature: "Live transfer",
    },
    {
        title: "One part of a huge file",
        body: "A researcher needs one range from a large archive. Only that range crosses the network, and the rest stays where it is.",
        feature: "Verified byte ranges",
    },
];
---

<section class="section use-cases" id="uses" aria-labelledby="uses-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="uses-title">Where it helps</h2>
            <p class="section-lede">
                Four jobs where a stop in the cloud costs time, money or privacy. Each one names the
                1.0 feature it uses.
            </p>
        </div>

        <div class="case-grid">
            {cases.map((item) => (
                <article class="case">
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                    <p class="case-feature mono">1.0: {item.feature}</p>
                </article>
            ))}
        </div>
    </div>
</section>
