// The Worker that serves dist/, with no code of its own (ADR 0022). Workers Builds runs
// `npm ci && npm run build` in site/ and then deploys the result; the assets are the whole Worker.
// There is no domain yet, so the files are served under workers.dev. When one exists, set SITE_URL
// in site/src/site.ts and add a routes entry here in the same change.
{
    "name": "sluice",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
    },
    "workers_dev": true,
    "observability": { "enabled": false },
}
